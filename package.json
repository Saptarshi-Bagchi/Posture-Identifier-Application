{
  "name": "i-spa",
  "version": "1.0.0",
  "description": "I-SPA — Incorrect Posture Determination via Spine Alignment.",
  "main": "desktop-app/electron/main.js",
  "homepage": "https://github.com/Saptarshi-Bagchi/Posture-Identifier-Application",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saptarshi-Bagchi/Posture-Identifier-Application.git"
  },
  "author": "",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron desktop-app/electron/main.js",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && cross-env I_SPA_DEV=1 npm run electron\"",
    "setup:backend": "python -m pip install -r backend/requirements.txt",
    "start": "npm run build && npm run electron",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.ispa.spinealignment",
    "productName": "I-SPA",
    "directories": {
      "output": "release",
      "buildResources": "src/assets"
    },
    "files": [
      "dist/**/*",
      "desktop-app/**/*",
      "backend/**/*",
      "src/assets/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/ispa-logo.png"
    },
    "mac": {
      "icon": "src/assets/ispa-logo.png"
    },
    "linux": {
      "icon": "src/assets/ispa-logo.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
